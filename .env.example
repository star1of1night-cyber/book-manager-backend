# ============================================
# ملف الإعدادات - انسخ هذا الملف باسم .env
# وضع فيه المفاتيح الخاصة بك
# ============================================

# منفذ تشغيل الخادم
PORT=5000

# ------------------------------------------------
# 1) قاعدة البيانات السحابية (MongoDB Atlas - مجاني)
# احصل على الرابط من: https://www.mongodb.com/cloud/atlas/register
# ------------------------------------------------
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/book-manager?retryWrites=true&w=majority

# ------------------------------------------------
# 2) خدمة تحويل الصور إلى نص (OCR)
# اختر واحدة من الخيارات التالية:
#
# الخيار أ) OCR.space (لديه باقة مجانية 25000 طلب/شهر)
# سجل هنا: https://ocr.space/ocrapi/freekey
OCR_PROVIDER=ocrspace
OCR_SPACE_API_KEY=ضع_مفتاحك_هنا

# الخيار ب) Google Cloud Vision (دقة أعلى، له باقة مجانية محدودة)
# سجل هنا: https://cloud.google.com/vision/docs/setup
# GOOGLE_VISION_API_KEY=ضع_مفتاحك_هنا

# ------------------------------------------------
# 3) خدمة الذكاء الاصطناعي للإجابة عن الأسئلة
# اختر واحدة من الخيارات التالية:
#
# الخيار أ) Google Gemini (طبقة مجانية حقيقية بدون شحن رصيد - موصى به)
# سجل هنا: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=ضع_مفتاحك_هنا
GEMINI_MODEL=gemini-2.0-flash

# الخيار ب) DeepSeek (رخيص جدًا، يحتاج شحن رصيد صغير)
# سجل هنا: https://platform.deepseek.com/
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=ضع_مفتاحك_هنا
# DEEPSEEK_MODEL=deepseek-chat

# الخيار ج) Claude (Anthropic)
# سجل هنا: https://console.anthropic.com/
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=ضع_مفتاحك_هنا
# ANTHROPIC_MODEL=claude-sonnet-4-6

# الخيار د) OpenAI (ChatGPT)
# سجل هنا: https://platform.openai.com/api-keys
# AI_PROVIDER=openai
# OPENAI_API_KEY=ضع_مفتاحك_هنا
# OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------
# مفتاح سري لتشفير جلسات المستخدم (ضع أي نص عشوائي طويل)
# ------------------------------------------------
JWT_SECRET=غيّر_هذا_النص_الى_شيء_عشوائي_وطويل_وسري
